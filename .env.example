# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/scraper.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Scraper Security & Limits
MAX_CONCURRENT_SCRAPES=5
